# Valeurs de la COMPOSITION, celle qui se déploie. Copier en .env, jamais versionné.
#
# Deux natures, et c'est tout ce qu'il y a à retenir :
#
#   SECRET    Vient de secrets.enc.yaml, injecté par `sops exec-env`
#             (docs/secrets.md). Le renseigner ici n'est utile que si vous
#             lancez la pile sans sops. Jamais en clair dans le dépôt.
#   RÉGLAGE   Jamais chiffré. Varie d'un environnement à l'autre, se lit en clair.
#
# D'où la façon la plus propre de lancer la pile sur un poste : ne remplir que
# les RÉGLAGES, et `sops exec-env secrets.enc.yaml 'docker compose up -d'`.
# L'environnement prime sur ce fichier, donc les valeurs déchiffrées gagnent.
#
# La boucle de développement ne lit PAS ce fichier : ses valeurs sont dans
# .env.dev, versionné parce qu'il n'a aucun secret. `pnpm dev:db` puis `pnpm dev`,
# rien à renseigner. Les deux fichiers n'ont aucune variable en commun.


# ============================== SECRETS ==============================

# Compte PostgreSQL de la pile.
POSTGRES_PASSWORD=

# Scelle le cookie de session, 32 caractères au moins ; l'état, lui, vit dans la
# table sessions. La composition le transmet au conteneur sous le nom qu'attend
# nuxt-auth-utils, NUXT_SESSION_PASSWORD.
SESSION_SECRET=

# Rôle PostgreSQL de l'ETL, droits bornés à la table sites et à ses colonnes
# (docs/data.md). Créé sans LOGIN par la migration 0001, activé par l'amorçage.
# PAS ENCORE dans secrets.enc.yaml : à y poser avant le premier déploiement,
# sinon `sops exec-env` échouera sur le `:?` de la composition.
ETL_DB_PASSWORD=

# API Mock IoT, URL fournie par le formateur au J1. Ira dans secrets.enc.yaml le
# jour où elle sera connue, d'où son absence actuelle du fichier chiffré.
MOCK_API_URL=http://

# Les trois comptes de démonstration créés par `pnpm db:seed`. Cette commande se
# joue à la main, la composition n'en a jamais besoin. Sans valeur, l'amorçage
# s'arrête plutôt que d'en deviner une.
SEED_PASSWORD=

# Compte administrateur de Grafana. C'est la porte de la supervision : elle
# montre l'état de la machine, elle s'authentifie comme le reste. Sans valeur,
# la pile refuse de démarrer plutôt que de garder le mot de passe par défaut de
# l'image, qui est public.
GRAFANA_ADMIN_PASSWORD=


# ============================== RÉGLAGES ==============================

POSTGRES_DB=enervision
POSTGRES_USER=enervision
# Publié sur la boucle locale seulement, pratique pour un client SQL sur le poste.
# Sur un poste où PostgreSQL est installé en service Windows, 5432 est déjà pris
# et le lancement échoue sur « ports are not available ». Poser 15432 ici suffit,
# il n'y a rien à désinstaller.
POSTGRES_PORT=5432
# Sur un poste où PostgreSQL tourne déjà en service Windows, 5432 est pris.
# Poser 15432 ici suffit, rien à désinstaller.
POSTGRES_HOST_PORT=5432

# Supervision, sur la boucle locale elle aussi. Grafana sort sur 3001 et non
# 3000 : le dashboard tient déjà ce port. Prometheus s'ouvre pour interroger
# ses cibles à la main quand un panneau ne dit pas ce qu'on attendait.
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
# Le compte d'administration de Grafana. Le mot de passe, lui, est un secret.
GRAFANA_ADMIN_USER=admin

# Service ML, conteneur du réseau interne : joignable par son nom de service,
# aucun port publié sur l'hôte.
ML_API_URL=http://ml:8000

# Stockage des mesures. Seul le chemin de la MACHINE se renseigne, c'est le seul
# qui varie. Le chemin vu DANS les conteneurs vaut toujours /data, posé par la
# composition et lu sous le nom PARQUET_DIR. Le playbook Ansible le crée.
PARQUET_DIR_HOST=./data/parquet

# Autorise la limitation des tentatives à croire X-Forwarded-For. À laisser faux
# tant que l'applicatif est joignable autrement que par le proxy de #39 : sinon
# l'en-tête se forge et la limitation ne limite plus rien.
DOMAIN=localhost            # nom de domaine ou IP de la VM, sans https://
TRUST_PROXY=true            # mettre à true dès qu'un proxy est en frontal
LOG_LEVEL=info


# ================= Hors composition, sur un poste =================
# Les commandes qui parlent à la base sans passer par un conteneur, `pnpm
# db:migrate` et `pnpm db:seed`, assemblent leur URL à partir des variables
# ci-dessus, exactement comme l'applicatif et comme l'ETL. Il suffit donc
# d'ajouter l'hôte, celui vu depuis le poste :
POSTGRES_HOST=localhost

# NUXT_DATABASE_URL reste possible et l'emporte sur les morceaux. Elle sert la
# boucle locale et les tests, à qui Testcontainers rend une chaîne toute faite.
# Elle porte un mot de passe : même précaution que les secrets ci-dessus.
# NUXT_DATABASE_URL=postgresql://enervision:MOT_DE_PASSE@localhost:5432/enervision
