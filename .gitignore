# Dépendances
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Builds
dist/
.output/
.nuxt/
.nitro/

# Environnement local (jamais versionné)
.env
.env.local
*.local

# Terraform : état et variables contiennent des données sensibles
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Secrets déchiffrés : seul secrets.enc.yaml est versionné
secrets.yaml
secrets.dec.yaml

# Clés privées : jamais dans le dépôt. Les clés publiques restent autorisées (!*.pub).
*.key
keys.txt
!*.pub

# Données et modèles : trop volumineux, pas versionnables
data/
# ``apps/ml/src/data`` contains Python source code, not generated datasets.
!apps/ml/src/data/
!apps/ml/src/data/**
mlruns/
*.pkl
*.joblib

# Rapports locaux générés depuis les Parquet
apps/etl/insights/*.json
apps/etl/insights/*.html

# Conceptions et plans de travail : documents de méthode, pas des livrables.
# Ils restent sur le poste et dans l'historique, ils ne sont plus versionnés.
.superpowers/
docs/superpowers/

# Rapports de couverture, produits par pytest-cov et Vitest à chaque exécution
# des tests. La CI les transmet à SonarCloud comme artefacts, jamais par git.
.coverage
coverage.xml
coverage/

# Divers
*.log
.DS_Store
.idea/
.vscode/
.claude
.hidden

.kilo/

.claude/
