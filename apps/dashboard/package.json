    "db:seed": "tsx --env-file-if-exists=../../.env server/database/seed.cli.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@nuxt/ui": "^4.11.1",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@vue/test-utils": "^2.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11",
    "zod": "^4.6.5"
