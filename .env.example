# Copier en .env (jamais versionné) et renseigner.
# Les secrets de production sont chiffrés avec SOPS et age, pas stockés ici.

# Base de données
POSTGRES_DB=enervision
POSTGRES_USER=enervision
POSTGRES_PASSWORD=

# URL de connexion de l'applicatif, lue par Nuxt (runtimeConfig.databaseUrl) et
# par drizzle-kit. Le préfixe NUXT_ est la convention Nuxt : il alimente seul la
# clé databaseUrl déclarée dans nuxt.config.ts.
# L'hôte ci-dessous vaut pour un applicatif lancé sur le poste. Depuis un
# conteneur de la composition, ce n'est pas localhost mais le nom du service,
# postgres:5432 : docker-compose.yml assemble alors l'URL lui-même.
NUXT_DATABASE_URL=postgresql://enervision:MOT_DE_PASSE@localhost:5432/enervision

# Rôle PostgreSQL de l'ETL, droits bornés à la table sites et à ses colonnes
# (docs/data.md). Créé sans LOGIN par la migration 0001, activé par l'amorçage.
# Valeur chiffrée avec SOPS, jamais en clair ici.
ETL_DB_PASSWORD=

# Mot de passe des trois comptes de démonstration créés par `pnpm db:seed`.
# Sans elle, l'amorçage s'arrête plutôt que de poser un mot de passe deviné.
SEED_PASSWORD=

# Secret de session de l'applicatif, 32 caractères au moins. Il scelle le cookie
# qui porte l'identifiant de session ; l'état, lui, vit dans la table sessions.
# Nom neutre, comme les autres : la composition le transmet au conteneur sous le
# nom que nuxt-auth-utils attend, NUXT_SESSION_PASSWORD. C'est aussi la clé
# injectée par `sops exec-env` au déploiement.
SESSION_SECRET=

# Réseau
POSTGRES_PORT=5432
# API Mock IoT, URL fournie par le formateur au J1
MOCK_API_URL=http://
# Service ML, conteneur du réseau interne : joignable par son nom de service,
# aucun port publié sur l'hôte.
ML_API_URL=http://ml:8000

# Stockage des mesures. Seul le chemin de la MACHINE se renseigne ici : c'est
# le seul qui varie, entre un poste et la VM. Le playbook Ansible le crée.
#
# Le chemin vu DANS le conteneur vaut toujours /data : c'est une convention
# interne, posée par la composition, pas un réglage. Les services le lisent
# sous le nom PARQUET_DIR, que la composition renseigne pour eux.
PARQUET_DIR_HOST=./data/parquet

# Dashboard
# Le même secret que SESSION_SECRET ci-dessus, sous le nom que Nuxt lit. Il ne
# sert qu'à l'applicatif lancé HORS composition, directement sur le poste :
# dedans, docker-compose.yml le dérive de SESSION_SECRET.
NUXT_SESSION_PASSWORD=
# Autorise la limitation des tentatives à croire X-Forwarded-For. À laisser
# faux tant que l'applicatif est joignable autrement que par le proxy de #39 :
# sinon l'en-tête se forge et la limitation ne limite plus rien.
TRUST_PROXY=false
LOG_LEVEL=info
