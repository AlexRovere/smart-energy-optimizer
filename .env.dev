

POSTGRES_DB=enervision
POSTGRES_PORT=55432
POSTGRES_HOST_PORT=15432
POSTGRES_USER=enervision
POSTGRES_PASSWORD=enervision-dev-local
DEV_DB_PORT=55432

# La même base, vue depuis le poste. Le mot de passe réapparaît parce que
# `--env-file` n'interpole pas : les deux lignes voisinent pour qu'un écart se voie.
NUXT_DATABASE_URL=postgresql://enervision:enervision-dev-local@localhost:55432/enervision

# Comptes de démonstration : admin@, operator@ et viewer@enervision.local.
SEED_PASSWORD=mot-de-passe-de-demonstration-local

# Rôle PostgreSQL `etl`, inutilisé en local : la valeur n'existe que parce que
# l'amorçage refuse d'en deviner une.
ETL_DB_PASSWORD=mot-de-passe-du-role-etl-en-local

# Au moins 32 caractères, exigés par nuxt-auth-utils.
NUXT_SESSION_PASSWORD=secret-de-session-local-sans-valeur-de-secret

MOCK_API_URL=http://localhost:9999
NUXT_MOCK_API_URL=http://localhost:9999
NUXT_ML_SERVICE_URL=http://localhost:8000

# Relatif à apps/dashboard/, et vide tant que l'ETL n'a pas tourné sur le poste.
NUXT_PARQUET_DIR=../../data/parquet
