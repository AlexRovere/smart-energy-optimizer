# Propriété par domaine. GitHub demande automatiquement la revue du propriétaire
# sur toute PR qui touche ses fichiers.
#
# C'est la DERNIÈRE règle qui correspond qui gagne : garder le général en haut,
# le spécifique en bas.
#
# Pour rendre la revue obligatoire : Settings > Branches > protection de `main`
# > cocher « Require review from Code Owners ».
#
# Les propriétaires sont les porteurs réels du domaine, pas le PO par défaut :
# une revue que tout le monde attribue à la même personne n'est plus une revue.

# Par défaut, tout le monde peut relire
*                       @AlexRovere

# Applicatif, ETL, modele : chacun relit son domaine
/apps/dashboard/        @antoinecoulon
/apps/etl/              @Shurtugl
/apps/ml/               @TanguyRaguenes

# Infrastructure et chaîne de build
/infra/                 @HugoMrnth
/.github/               @HugoMrnth @AlexRovere
/docker-compose.yml     @HugoMrnth

# Livrables : relus par le Product Owner
/docs/                  @AlexRovere
*.md                    @AlexRovere

# Secrets : un second relecteur, pas seulement l'auteur (règle la plus spécifique, donc en dernier).
/.sops.yaml             @AlexRovere @HugoMrnth
/secrets.enc.yaml       @AlexRovere @HugoMrnth
