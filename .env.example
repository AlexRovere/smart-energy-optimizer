# Copier en .env (jamais versionné) et renseigner.
# Les secrets de production sont chiffrés avec SOPS et age, pas stockés ici.

# Base de données
POSTGRES_DB=enervision
POSTGRES_USER=enervision
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Secret de session de l'applicatif, 32 caracteres au moins. Il chiffre le cookie qui
# porte l'identifiant de session ; l'etat, lui, vit dans la table sessions.
SESSION_SECRET=

# API Mock IoT, URL fournie par le formateur au J1
MOCK_API_URL=http://

# Monitoring
GRAFANA_PASSWORD=

# Stockage des mesures. PARQUET_DIR est le chemin sur la MACHINE, créé par le
# playbook Ansible et monté sur /data dans les conteneurs qui en ont besoin.
# Les deux autres sont les chemins vus DEPUIS les conteneurs : ne pas les
# confondre, c'est la confusion qui a fait perdre du temps le 15 septembre.
PARQUET_DIR=./data/parquet
PARQUET_DIR_EXPOSE=/data/expose
PARQUET_DIR_ENTRAINEMENT=/data/entrainement

# Service ML, conteneur du réseau interne : joignable par son nom de service,
# aucun port publié sur l'hôte.
ML_API_URL=http://ml:8000
