# Valeurs de la pile de développement, versionnées pour qu'un clone neuf démarre
# sans rien renseigner. Aucun secret ici, par construction : tout n'écoute que
# 127.0.0.1 et ne porte que des données fictives. Ce qui mérite d'être chiffré
# va dans secrets.enc.yaml (docs/secrets.md).
#
# Valeurs volontairement sans hasard : elles disent ce qu'elles sont, et aucun
# scanner de secrets ne les prend pour des clés.
#
# Jamais lu par défaut : Compose ne charge que `.env`, celui de la production.
# Ce fichier n'entre que par `scripts/dev-stack.mjs`, qui le passe en
# `--env-file`. Une commande de production lancée sans le script ne le voit pas.
#
# Surcharge de poste : `.env.local` (ignoré par git), mêmes noms, il l'emporte.
# Par exemple POSTGRES_PUBLISHED_PORT et NUXT_DATABASE_URL si 55432 est pris.

# ---- Composition (docker-compose.yml + docker-compose.dev.yml) ----

POSTGRES_DB=enervision
POSTGRES_USER=enervision
POSTGRES_PASSWORD=enervision-dev-local
# Port vu du poste. Distinct de la production (5432) pour que les deux cohabitent.
POSTGRES_PUBLISHED_PORT=55432

# Comptes de démonstration : admin@, operator@ et viewer@enervision.local.
SEED_PASSWORD=mot-de-passe-de-demonstration-local
ETL_DB_PASSWORD=mot-de-passe-du-role-etl-en-local

# Au moins 32 caractères, exigés par nuxt-auth-utils.
SESSION_SECRET=secret-de-session-local-sans-valeur-de-secret

# Exigé par la composition de base même si la supervision ne démarre pas en dev :
# Compose résout toutes les variables avant d'écarter un service.
GRAFANA_ADMIN_PASSWORD=grafana-dev-local

# Le simulateur, jamais l'API de la formation (apps/mock-api).
MOCK_API_URL=http://mock-api:8000

# Données fictives, dans un volume nommé (docker-compose.dev.yml) : rapide, mais
# invisible du poste. `up --without-dashboard` le remplace par ./data/parquet-dev,
# que `pnpm dev` doit pouvoir lire.
PARQUET_DIR_HOST=parquet_dev
# Jours d'historique écrits au premier démarrage : de quoi entraîner le modèle.
DEV_HISTORY_DAYS=365

# Pas de proxy devant le dashboard en dev.
TRUST_PROXY=false

# ---- Dashboard lancé sur le poste (`pnpm dev`, pile démarrée sans lui) ----
# 127.0.0.1 et non localhost : sous Windows, localhost essaie IPv6 d'abord.

NUXT_DATABASE_URL=postgresql://enervision:enervision-dev-local@127.0.0.1:55432/enervision
NUXT_SESSION_PASSWORD=secret-de-session-local-sans-valeur-de-secret
NUXT_MOCK_API_URL=http://127.0.0.1:9999
NUXT_ML_SERVICE_URL=http://127.0.0.1:58000
# Relatif à apps/dashboard/, d'où `pnpm dev` est lancé.
NUXT_PARQUET_DIR=../../data/parquet-dev
